# Copy to .env and replace every placeholder before production deployment.
# docker compose --env-file .env -f docker-compose.prod.yml up -d --build

# REQUIRED. PostgreSQL password used by the db service and backend.
DB_PASSWORD=replace-with-a-strong-password

# REQUIRED. JWT HMAC secret — at least 32 bytes long; generate with:
#   openssl rand -base64 48
JWT_SECRET=please-generate-a-long-random-secret-at-least-32-bytes

# REQUIRED. Password for the initial admin account.
ADMIN_PASSWORD=replace-with-a-strong-password

# Comma-separated list of allowed frontend origins (default: http://localhost:8080)
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Initial admin identity (created by seeding on first startup)
ADMIN_EMAIL=admin@company.ru
ADMIN_FULL_NAME=Главный администратор

# Public port mapping for the nginx frontend (default: 8080)
PORT=8080
