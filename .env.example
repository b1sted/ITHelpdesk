# Copy to .env and adjust for production deployment
# docker compose -f docker-compose.prod.yml --env-file .env up -d --build

# PostgreSQL password used by the db service and backend
DB_PASSWORD=secure-db-password

# JWT HMAC secret — MUST be at least 32 bytes long; generate with:
#   openssl rand -base64 48
JWT_SECRET=please-generate-a-long-random-secret-at-least-32-bytes

# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Initial admin account (created by seeding on first startup)
ADMIN_EMAIL=admin@company.ru
ADMIN_PASSWORD=ChangeMe-Admin2024!
ADMIN_FULL_NAME=Главный администратор

# Public port mapping for the nginx frontend
PORT=8080